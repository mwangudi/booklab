# Bookshop BRANCH (offline) runtime configuration.
# Copy to backend/.env on the branch desktop and fill in the marked values.

# Local SQLite database for this branch (created by setup-branch.ps1).
BRANCH_DATABASE_URL="file:./branch.db"

# Local API — localhost only; the SPA is opened in a kiosk browser.
PORT=4000

# Mark this install as a branch runtime → enables the outbox.
SYNC_ROLE=branch

# Cloud master base URL.
CLOUD_URL="https://bookshop.example.co.ke"

# Per-branch service token. Mint on the cloud as an admin:
#   POST /api/sync/token  { "branchId": <this branch id> }
SYNC_TOKEN=""

# Sync loop cadence.
SYNC_LOOP=1
SYNC_INTERVAL_MS=60000

# Secret for LOCAL offline-login JWTs (any strong random string).
JWT_SECRET="change-me-to-a-strong-random-string"

CORS_ORIGIN="http://127.0.0.1:4000,http://localhost:4000"
