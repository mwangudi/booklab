# Cloud (master) backend configuration — copy to .env for local development.
DATABASE_URL="mysql://bookshop:password@localhost:3306/bookshop"
JWT_SECRET="dev-secret-change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# 'cloud' (master) or 'branch' (offline desktop runtime). Default cloud.
SYNC_ROLE=cloud

# --- M-Pesa (Safaricom Daraja) STK push ---
# MPESA_ENV: sandbox | production | mock  (mock simulates success without calling Daraja).
MPESA_ENV=mock
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# STK BusinessShortCode. Safaricom sandbox test paybill is 174379.
MPESA_SHORTCODE="174379"
# Lipa Na M-Pesa Online passkey (sandbox passkey is public; production is per-shortcode).
MPESA_PASSKEY=""
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till/Buy Goods).
MPESA_TX_TYPE=CustomerPayBillOnline
# Till/Buy-Goods number used as PartyB for Buy Goods transactions (defaults to MPESA_SHORTCODE).
MPESA_PARTYB=""
# Public HTTPS callback URL (use an ngrok tunnel locally, or rely on STK query polling).
MPESA_CALLBACK_URL="https://your-public-host/api/mpesa/callback"
MPESA_ACCOUNT_REF="Booklab"
