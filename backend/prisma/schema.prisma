// Bookshop management — Prisma schema (cloud/MySQL).
// The SQLite branch variant is generated from this file by scripts/gen-sqlite-schema.mjs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
}

enum PriceTier {
  RETAIL
  WHOLESALE
  SCHOOL
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  SUPPLIES
  MARKETING
  MISC
}

enum StockMoveType {
  INTAKE
  ADJUST
  SALE
  VOID
  TRANSFER_IN
  TRANSFER_OUT
}

enum MpesaStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  CASUAL
  INTERN
}

enum PayrollStatus {
  DRAFT
  CLOSED
}

enum CustomerType {
  SCHOOL
  INSTITUTION
  BUSINESS
  INDIVIDUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  DELIVERED
  PAID
  CANCELLED
}

enum PaymentChannel {
  CASH
  MPESA
  BANK_TRANSFER
  CHEQUE
  CARD
}

/// Whether the prices captured on an invoice already contain VAT.
enum VatMode {
  EXCLUSIVE
  INCLUSIVE
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  /// Short sign-in name for the till, e.g. mumias.cashier. Optional: older
  /// accounts sign in with their email until one is set.
  username     String?   @unique @db.VarChar(60)
  passwordHash String
  name         String
  role         Role      @default(CASHIER)
  active       Boolean   @default(true)
  branchId     Int?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  createdAt    DateTime  @default(now())
  uuid         String    @unique @default(uuid())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  sales        Sale[]
  voidedSales  Sale[]          @relation("SaleVoidedBy")
  movements    StockMovement[]
  auditLogs    AuditLog[]
  employee     Employee?
}

model Branch {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  /// Short code that prefixes documents raised here, e.g. KAP-0007. Two branches
  /// working offline must never mint the same invoice number.
  code      String    @unique
  location  String
  createdAt DateTime  @default(now())
  uuid      String    @unique @default(uuid())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  users     User[]
  stock     Stock[]
  sales     Sale[]
  expenses  Expense[]
  movements StockMovement[]
  employees Employee[]
  invoices  Invoice[]
  receipts  GoodsReceipt[]
  syncTokens SyncToken[]
}

/// A book is the sellable product. `sku` is the internal code; `isbn` optional.
model Book {
  id        Int        @id @default(autoincrement())
  title     String
  author    String?
  isbn      String?    @unique
  sku       String     @unique
  category  String?
  /// Unit the product is sold in — Piece, Dozen, Ream, Carton, Metre, etc.
  unit      String     @default("Piece")
  /// VAT percentage applied when invoicing. Printed books are zero-rated in Kenya.
  vatRate   Decimal    @default(16) @db.Decimal(5, 2)
  unitPrice Decimal    @db.Decimal(10, 2)
  /// Optional wholesale/school tier prices. When null, `unitPrice` (retail) applies.
  priceWholesale Decimal? @db.Decimal(10, 2)
  priceSchool    Decimal? @db.Decimal(10, 2)
  costPrice Decimal    @db.Decimal(10, 2)
  createdAt DateTime   @default(now())
  uuid      String     @unique @default(uuid())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  stock     Stock[]
  saleItems SaleItem[]
  movements StockMovement[]
  invoiceItems InvoiceItem[]
  receiptItems GoodsReceiptItem[]

  @@index([deletedAt])
}

/// On-hand quantity of a book at a branch. Derived from movement events on sync.
model Stock {
  id       Int      @id @default(autoincrement())
  branchId Int
  bookId   Int
  quantity Int      @default(0)
  /// Optional per-branch prices. Any that is null falls back to the catalogue
  /// value on Book, so a branch stores only what it genuinely differs on.
  price          Decimal? @db.Decimal(10, 2)
  priceWholesale Decimal? @db.Decimal(10, 2)
  priceSchool    Decimal? @db.Decimal(10, 2)
  /// What THIS branch paid. Drives COGS for sales rung here.
  costPrice      Decimal? @db.Decimal(10, 2)
  branch   Branch   @relation(fields: [branchId], references: [id])
  book     Book     @relation(fields: [bookId], references: [id])

  @@unique([branchId, bookId])
}

model Sale {
  id             Int           @id @default(autoincrement())
  branchId       Int
  userId         Int
  /// Sum of the lines before any discount.
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  /// Cash amount taken off at the till. Never exceeds the subtotal.
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  discountReason String?
  total          Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  mpesaRef       String?
  priceTier      PriceTier     @default(RETAIL)
  /// Set when the sale is reversed. Voided sales are excluded from all revenue reporting.
  voidedAt       DateTime?
  voidedById     Int?
  voidReason     String?
  /// How many duplicate copies of the receipt have been printed.
  reprintCount   Int           @default(0)
  createdAt      DateTime      @default(now())
  uuid           String        @unique @default(uuid())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  originBranchId Int?
  branch         Branch        @relation(fields: [branchId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  voidedBy       User?         @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  items          SaleItem[]

  @@index([branchId, createdAt])
  @@index([voidedAt])
}

model SaleItem {
  id        Int       @id @default(autoincrement())
  saleId    Int
  bookId    Int
  quantity  Int
  unitPrice Decimal   @db.Decimal(10, 2)
  // Cost snapshot at sale time so P&L COGS is accurate historically.
  costPrice Decimal   @default(0) @db.Decimal(10, 2)
  uuid      String    @unique @default(uuid())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id])
}

model Expense {
  id             Int             @id @default(autoincrement())
  branchId       Int?
  category       ExpenseCategory
  description    String?
  amount         Decimal         @db.Decimal(12, 2)
  incurredAt     DateTime        @default(now())
  /// Set when the expense was posted automatically by closing a payroll run.
  payrollRunId   Int?
  uuid           String          @unique @default(uuid())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  originBranchId Int?
  branch         Branch?         @relation(fields: [branchId], references: [id])

  @@index([branchId, incurredAt])
  @@index([payrollRunId])
}

/// Event-sourced stock change (intake/adjustment). Synced idempotently by uuid;
/// each side applies the delta to Stock. Sales carry their own decrement events.
model StockMovement {
  id             Int           @id @default(autoincrement())
  branchId       Int
  bookId         Int
  delta          Int
  type           StockMoveType @default(INTAKE)
  note           String?
  /// Who performed the movement (null for system/sync-applied events).
  userId         Int?
  createdAt      DateTime      @default(now())
  uuid           String        @unique @default(uuid())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  originBranchId Int?
  branch         Branch        @relation(fields: [branchId], references: [id])
  book           Book          @relation(fields: [bookId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([branchId, createdAt])
  @@index([bookId, createdAt])
}

/// Append-only trail of sensitive changes (price overrides, voids, transfers).
model AuditLog {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int?
  branchId  Int?
  entity    String
  entityId  Int?
  action    String
  details   String?  @db.Text
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// An M-Pesa STK push (Lipa Na M-Pesa Online) request and its result. Cloud-only.
model MpesaPayment {
  id                Int         @id @default(autoincrement())
  checkoutRequestId String      @unique
  merchantRequestId String?
  amount            Decimal     @db.Decimal(12, 2)
  phone             String
  accountRef        String?
  status            MpesaStatus @default(PENDING)
  resultCode        Int?
  resultDesc        String?     @db.Text
  mpesaReceipt      String?
  branchId          Int?
  saleId            Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, createdAt])
}

/// Local write queue on a branch runtime; drained to the cloud by the sync runner.
model Outbox {
  id         Int       @id @default(autoincrement())
  entity     String
  entityUuid String
  op         String    @default("upsert")
  payload    String    @db.LongText
  createdAt  DateTime  @default(now())
  syncedAt   DateTime?
  attempts   Int       @default(0)
  lastError  String?   @db.Text

  @@index([syncedAt])
  @@index([entity, entityUuid])
}

/// Per-entity pull/push cursors on a branch runtime.
model SyncState {
  id           Int       @id @default(autoincrement())
  entity       String    @unique
  lastPulledAt DateTime?
  lastPushedAt DateTime?
  cursor       String?
  updatedAt    DateTime  @updatedAt
}

/// A branch laptop's sync credential. The token it holds is long-lived, so the
/// JWT carries this row's `jti` and every sync request checks it is still
/// active — a lost laptop can be cut off without rotating the server secret and
/// signing everyone else out.
model SyncToken {
  id          Int       @id @default(autoincrement())
  jti         String    @unique
  branchId    Int
  /// Which machine this was issued for, so the right one can be revoked.
  label       String
  active      Boolean   @default(true)
  createdById Int?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  revokedById Int?
  branch      Branch    @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

/// A person on the payroll. Deliberately separate from `User`: staff who never
/// sign in still get paid, and not every login is an employee. `userId` links
/// the two when the person does have an account.
model Employee {
  id                 Int            @id @default(autoincrement())
  staffNo            String         @unique
  firstName          String
  lastName           String
  nationalId         String?
  kraPin             String?
  nssfNo             String?
  shifNo             String?
  phone              String?
  email              String?
  jobTitle           String?
  employmentType     EmploymentType @default(PERMANENT)
  branchId           Int?
  userId             Int?           @unique
  basicSalary        Decimal        @default(0) @db.Decimal(12, 2)
  houseAllowance     Decimal        @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal        @default(0) @db.Decimal(12, 2)
  otherAllowance     Decimal        @default(0) @db.Decimal(12, 2)
  otherDeductions    Decimal        @default(0) @db.Decimal(12, 2)
  bankName           String?
  bankAccount        String?
  hiredAt            DateTime?
  endedAt            DateTime?
  active             Boolean        @default(true)
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  uuid               String         @unique @default(uuid())
  branch             Branch?        @relation(fields: [branchId], references: [id])
  user               User?          @relation(fields: [userId], references: [id])
  payslips           Payslip[]

  @@index([branchId, active])
  @@index([deletedAt])
}

/// One monthly payroll cycle across the whole business. Draft until closed;
/// closing locks the figures and posts the cost to the P&L as SALARY expenses.
model PayrollRun {
  id              Int           @id @default(autoincrement())
  year            Int
  month           Int
  status          PayrollStatus @default(DRAFT)
  note            String?
  grossTotal      Decimal       @default(0) @db.Decimal(14, 2)
  deductionsTotal Decimal       @default(0) @db.Decimal(14, 2)
  netTotal        Decimal       @default(0) @db.Decimal(14, 2)
  employerTotal   Decimal       @default(0) @db.Decimal(14, 2)
  createdById     Int?
  closedById      Int?
  closedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payslips        Payslip[]

  @@unique([year, month])
  @@index([status])
}

/// A single employee's pay for one run. Figures are snapshotted so historical
/// payslips never change when salaries or statutory rates are updated.
model Payslip {
  id                  Int        @id @default(autoincrement())
  runId               Int
  employeeId          Int
  branchId            Int?
  basicSalary         Decimal    @default(0) @db.Decimal(12, 2)
  allowances          Decimal    @default(0) @db.Decimal(12, 2)
  grossPay            Decimal    @default(0) @db.Decimal(12, 2)
  nssf                Decimal    @default(0) @db.Decimal(12, 2)
  shif                Decimal    @default(0) @db.Decimal(12, 2)
  housingLevy         Decimal    @default(0) @db.Decimal(12, 2)
  taxablePay          Decimal    @default(0) @db.Decimal(12, 2)
  paye                Decimal    @default(0) @db.Decimal(12, 2)
  otherDeductions     Decimal    @default(0) @db.Decimal(12, 2)
  totalDeductions     Decimal    @default(0) @db.Decimal(12, 2)
  netPay              Decimal    @default(0) @db.Decimal(12, 2)
  employerNssf        Decimal    @default(0) @db.Decimal(12, 2)
  employerHousingLevy Decimal    @default(0) @db.Decimal(12, 2)
  run                 PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee            Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
  @@index([employeeId])
}

/// Statutory rates, editable by an admin so PAYE/NSSF/SHIF changes never need a
/// code release. Single row (id = 1). `payeBands` is JSON: [{ upTo, rate }].
model PayrollSetting {
  id              Int      @id @default(1)
  payeBands       String   @db.Text
  personalRelief  Decimal  @default(2400) @db.Decimal(12, 2)
  insuranceRelief Decimal  @default(0) @db.Decimal(12, 2)
  nssfTier1Limit  Decimal  @default(8000) @db.Decimal(12, 2)
  nssfTier2Limit  Decimal  @default(72000) @db.Decimal(12, 2)
  nssfRate        Decimal  @default(0.06) @db.Decimal(6, 4)
  shifRate        Decimal  @default(0.0275) @db.Decimal(6, 4)
  shifMinimum     Decimal  @default(300) @db.Decimal(12, 2)
  housingLevyRate Decimal  @default(0.015) @db.Decimal(6, 4)
  updatedAt       DateTime @updatedAt
}

/// A school, institution or business we supply on account.
model Customer {
  id            Int          @id @default(autoincrement())
  name          String
  type          CustomerType @default(SCHOOL)
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  kraPin        String?
  notes         String?      @db.Text
  /// Whether this customer is invoiced with VAT at all, and how their prices are quoted.
  chargeVat     Boolean      @default(true)
  vatMode       VatMode      @default(EXCLUSIVE)
  /// Debt carried over from before the system went live; shown as "Balance forward".
  openingBalance     Decimal   @default(0) @db.Decimal(12, 2)
  openingBalanceDate DateTime?
  /// Days the customer has to settle an invoice.
  paymentTermsDays   Int       @default(30)
  active        Boolean      @default(true)
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  uuid          String       @unique @default(uuid())
  invoices      Invoice[]
  payments      CustomerPayment[]

  @@index([deletedAt])
  @@index([name])
}

/// Money received from a credit customer. Appears as a PMT credit on the statement.
model CustomerPayment {
  id          Int            @id @default(autoincrement())
  uuid        String         @unique @default(uuid())
  customerId  Int
  invoiceId   Int?
  amount      Decimal        @db.Decimal(12, 2)
  paidAt      DateTime       @default(now())
  method      PaymentChannel @default(BANK_TRANSFER)
  reference   String?
  note        String?
  createdById Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  customer    Customer       @relation(fields: [customerId], references: [id])
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id])

  @@index([customerId, paidAt])
  @@index([invoiceId])
}

/// An invoice raised against a customer, with the delivery note printed from
/// the same lines. Editable while it is still a draft.
model Invoice {
  id                  Int           @id @default(autoincrement())
  uuid                String        @unique @default(uuid())
  number              String        @unique
  deliveryNoteNo      String?
  customerId          Int
  branchId            Int?
  status              InvoiceStatus @default(DRAFT)
  priceTier           PriceTier     @default(SCHOOL)
  issueDate           DateTime      @default(now())
  dueDate             DateTime?
  deliveredAt         DateTime?
  /// Signature block captured from the delivery note.
  receivedBy          String?
  receivedIdNo        String?
  receivedDesignation String?
  notes               String?       @db.Text
  /// Copied from the customer when the invoice is raised, then editable here.
  chargeVat           Boolean       @default(true)
  vatMode             VatMode       @default(EXCLUSIVE)
  subtotal            Decimal       @default(0) @db.Decimal(12, 2)
  vatTotal            Decimal       @default(0) @db.Decimal(12, 2)
  total               Decimal       @default(0) @db.Decimal(12, 2)
  /// Set once delivery is confirmed and the goods are booked out as a sale.
  saleId              Int?
  createdById         Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
  customer            Customer      @relation(fields: [customerId], references: [id])
  branch              Branch?       @relation(fields: [branchId], references: [id])
  items               InvoiceItem[]
  payments            CustomerPayment[]

  @@index([customerId, issueDate])
  @@index([status])
  @@index([deletedAt])
}

/// A line on an invoice. `description` and `unit` are snapshots so a printed
/// document never changes when the catalogue does.
model InvoiceItem {
  id          Int     @id @default(autoincrement())
  uuid        String  @unique @default(uuid())
  invoiceId   Int
  bookId      Int?
  description String
  unit        String  @default("Piece")
  quantity    Decimal @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  vatRate     Decimal @default(16) @db.Decimal(5, 2)
  /// Net of VAT.
  netAmount   Decimal @default(0) @db.Decimal(12, 2)
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  /// Net + VAT.
  total       Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  book        Book?   @relation(fields: [bookId], references: [id])

  @@index([invoiceId])
}

/// A supplier we buy stock from.
model Supplier {
  id            Int            @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  kraPin        String?
  notes         String?        @db.Text
  /// What we already owed this supplier before they were added here.
  openingBalance     Decimal   @default(0) @db.Decimal(12, 2)
  openingBalanceDate DateTime?
  /// Days we have to settle their invoices.
  paymentTermsDays   Int       @default(30)
  active        Boolean        @default(true)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  uuid          String         @unique @default(uuid())
  receipts      GoodsReceipt[]
  payments      SupplierPayment[]

  @@index([deletedAt])
  @@index([name])
}

/// Money paid out to a supplier. Appears as a credit on their statement.
model SupplierPayment {
  id          Int            @id @default(autoincrement())
  uuid        String         @unique @default(uuid())
  supplierId  Int
  receiptId   Int?
  amount      Decimal        @db.Decimal(12, 2)
  paidAt      DateTime       @default(now())
  method      PaymentChannel @default(BANK_TRANSFER)
  reference   String?
  note        String?
  createdById Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  receipt     GoodsReceipt?  @relation(fields: [receiptId], references: [id])

  @@index([supplierId, paidAt])
  @@index([receiptId])
}

/// Goods received from a supplier, keyed from their delivery note. Posting it
/// adds the quantities to branch stock as attributable intake movements.
model GoodsReceipt {
  id             Int                @id @default(autoincrement())
  uuid           String             @unique @default(uuid())
  number         String             @unique
  supplierId     Int
  branchId       Int
  deliveryNoteNo String?
  invoiceNo      String?
  receivedAt     DateTime           @default(now())
  status         GoodsReceiptStatus @default(DRAFT)
  notes          String?            @db.Text
  totalCost      Decimal            @default(0) @db.Decimal(12, 2)
  createdById    Int?
  postedById     Int?
  postedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  supplier       Supplier           @relation(fields: [supplierId], references: [id])
  branch         Branch             @relation(fields: [branchId], references: [id])
  items          GoodsReceiptItem[]
  payments       SupplierPayment[]

  @@index([supplierId, receivedAt])
  @@index([branchId, receivedAt])
  @@index([status])
}

model GoodsReceiptItem {
  id          Int          @id @default(autoincrement())
  uuid        String       @unique @default(uuid())
  receiptId   Int
  bookId      Int
  description String
  unit        String       @default("Piece")
  quantity    Int          @default(0)
  unitCost    Decimal      @default(0) @db.Decimal(12, 2)
  total       Decimal      @default(0) @db.Decimal(12, 2)
  sortOrder   Int          @default(0)
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  book        Book         @relation(fields: [bookId], references: [id])

  @@index([receiptId])
}

/// Pictures shown on the login screen, managed from Administration -> Login
/// screen. The bytes live in the database on purpose: a restored backup brings
/// the branding back with it, and a redeploy cannot wipe them the way files
/// under dist/ would be.
model PromoSlide {
  id        Int      @id @default(autoincrement())
  title     String?  @db.VarChar(120)
  subtitle  String?  @db.VarChar(300)
  mimeType  String   @default("image/jpeg") @db.VarChar(60)
  image     Bytes
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}
